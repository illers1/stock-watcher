// Stock Watcher on Cloudflare Workers. See cloudflare/worker.mjs.
//
// Deployed by Cloudflare from GitHub on every push to main ("npx wrangler
// deploy"); nothing needs creating by hand. The D1 database for the shared
// group lists is created on the first deploy and stays linked afterwards.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "stock-watcher",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-01",

  // The pages, served by Cloudflare directly. /api/* goes to the Worker.
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    // Every link in the pages is written "movers.html", so serve exactly that.
    // Cloudflare's default would redirect it to "/movers", which costs a round
    // trip on each navigation and leaves the service worker holding redirected
    // responses, which a browser will not use for a page it is navigating to.
    // The bare "/" has no file of its own, so the Worker answers it.
    "html_handling": "none",
    "run_worker_first": ["/api/*", "/"]
  },

  // Serve cached API answers without running the Worker at all. Each
  // endpoint's own Cache-Control decides what is cached and for how long.
  "cache": { "enabled": true },

  // Shared group lists. D1 rather than KV: see cloudflare/groups-d1.mjs.
  "d1_databases": [{ "binding": "GROUPS" }],

  // One public address, the one in the README. Per-version preview URLs are
  // reachable by anyone who has them and are not needed here.
  "workers_dev": true,
  "preview_urls": false,

  "observability": { "enabled": true }
}
